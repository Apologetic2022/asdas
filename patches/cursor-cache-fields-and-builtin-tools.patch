--- /dev/null
+++ b/internal/cursor/headless_workspace_test.go
@@ -0,0 +1,66 @@
+package cursor
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// The gateway commonly runs as a service account whose home directory does not
+// exist and cannot be created by that account (a nologin user under a
+// root-owned /home). Rooting the workspace there advertises a path to the model
+// that nothing can write to, so every write it makes silently vanishes while
+// still being reported as a success.
+func TestHeadlessWorkspaceFallsBackWhenHomeIsUnusable(t *testing.T) {
+	t.Setenv("HOME", filepath.Join(t.TempDir(), "missing", "home"))
+	t.Setenv("TMPDIR", t.TempDir())
+
+	root, project := headlessWorkspaceRoot()
+	for _, dir := range []string{root, project} {
+		info, err := os.Stat(dir)
+		if err != nil || !info.IsDir() {
+			t.Fatalf("workspace %q was not created: %v", dir, err)
+		}
+	}
+
+	path := filepath.Join(root, "probe.txt")
+	if err := writeHeadlessWorkspaceFile(path, []byte("PROBE")); err != nil {
+		t.Fatalf("write into the fallback workspace: %v", err)
+	}
+	if data, err := os.ReadFile(path); err != nil || string(data) != "PROBE" {
+		t.Fatalf("read back err=%v data=%q", err, data)
+	}
+}
+
+// A write that cannot land must say so, so the exec is not answered with a
+// success for bytes that went nowhere.
+func TestWriteHeadlessWorkspaceFileReportsFailure(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	if err := writeHeadlessWorkspaceFile("/etc/nope.txt", []byte("x")); err == nil {
+		t.Fatal("a write outside the workspace must report an error")
+	}
+}
+
+// An exec must not be able to name its way out of the workspace.
+func TestHeadlessWorkspaceRefusesPathsOutsideRoot(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	root, _ := headlessWorkspaceRoot()
+
+	secret := filepath.Join(home, "outside.txt")
+	if err := os.WriteFile(secret, []byte("SECRET"), 0o600); err != nil {
+		t.Fatalf("seed outside file: %v", err)
+	}
+
+	for _, path := range []string{secret, filepath.Join(root, "..", "outside.txt"), ""} {
+		if _, ok := headlessWorkspacePath(path); ok {
+			t.Fatalf("%q must not resolve inside the workspace", path)
+		}
+		if err := writeHeadlessWorkspaceFile(path, []byte("CLOBBER")); err == nil {
+			t.Fatalf("%q must not be writable through the workspace", path)
+		}
+	}
+	if data, _ := os.ReadFile(secret); string(data) != "SECRET" {
+		t.Fatalf("file outside the workspace was overwritten: %q", data)
+	}
+}
