@@ -0,0 +1,63 @@
+package claude
+
+import (
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+// Cache reads and cache writes mean opposite things: one turn was served from
+// the cache, the other paid to fill it. OpenAI nests both under prompt_tokens;
+// Anthropic reports all three disjoint.
+func TestExtractOpenAIUsageSplitsCacheReadFromCacheCreation(t *testing.T) {
+	for _, tc := range []struct {
+		name                                          string
+		usage                                         string
+		wantInput, wantOutput, wantRead, wantCreation int64
+	}{
+		{
+			name: "cold turn writes the cache",
+			usage: `{"prompt_tokens":42760,"completion_tokens":4,
+			         "prompt_tokens_details":{"cached_tokens":18717,"cache_creation_tokens":24041}}`,
+			wantInput: 2, wantOutput: 4, wantRead: 18717, wantCreation: 24041,
+		},
+		{
+			name: "warm turn reads the cache",
+			usage: `{"prompt_tokens":42760,"completion_tokens":4,
+			         "prompt_tokens_details":{"cached_tokens":42758,"cache_creation_tokens":0}}`,
+			wantInput: 2, wantOutput: 4, wantRead: 42758, wantCreation: 0,
+		},
+		{
+			name:      "no cache details at all",
+			usage:     `{"prompt_tokens":100,"completion_tokens":7}`,
+			wantInput: 100, wantOutput: 7, wantRead: 0, wantCreation: 0,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			in, out, read, creation := extractOpenAIUsage(gjson.Parse(tc.usage))
+			if in != tc.wantInput || out != tc.wantOutput || read != tc.wantRead || creation != tc.wantCreation {
+				t.Fatalf("got input=%d output=%d read=%d creation=%d, want %d/%d/%d/%d",
+					in, out, read, creation,
+					tc.wantInput, tc.wantOutput, tc.wantRead, tc.wantCreation)
+			}
+		})
+	}
+}
+
+func TestSetClaudeCacheUsageOmitsZeroCounters(t *testing.T) {
+	out := setClaudeCacheUsage([]byte(`{}`), 18717, 24041)
+	if got := gjson.GetBytes(out, "usage.cache_read_input_tokens").Int(); got != 18717 {
+		t.Fatalf("cache_read_input_tokens = %d", got)
+	}
+	if got := gjson.GetBytes(out, "usage.cache_creation_input_tokens").Int(); got != 24041 {
+		t.Fatalf("cache_creation_input_tokens = %d", got)
+	}
+
+	// A turn that neither read nor wrote the cache carries neither key, the
+	// way the Anthropic API omits them.
+	out = setClaudeCacheUsage([]byte(`{}`), 0, 0)
+	if gjson.GetBytes(out, "usage.cache_read_input_tokens").Exists() ||
+		gjson.GetBytes(out, "usage.cache_creation_input_tokens").Exists() {
+		t.Fatalf("zero counters must be omitted, got %s", out)
+	}
+}
