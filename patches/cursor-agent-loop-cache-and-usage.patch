-func (c *conversationCache) Lookup(accountKey, fingerprint string) (*convEntry, bool) {
-	if accountKey == "" || fingerprint == "" {
+// convScope namespaces the conversation cache by model. A checkpoint is a
+// resumable upstream conversation, and upstream pins each one to the model
+// that opened it, so a checkpoint is only ever usable by that model.
+//
+// Keyed by account alone, two models that see the same transcript collided —
+// and agent clients make that the normal case, because every conversation
+// opens with the same system prompt and the same first user message. Whichever
+// model ran last overwrote the other's checkpoint, and the loser then found a
+// checkpoint pinned to a model it could not use and replayed its whole history
+// uncached for the rest of the conversation. Scoping by model gives each its
+// own entry, so neither evicts nor blocks the other.
+func convScope(accountKey, wireModelID string) string {
+	if accountKey == "" {
+		return ""
+	}
+	return accountKey + "\x00" + wireModelID
+}
+
+func (c *conversationCache) Lookup(scope, fingerprint string) (*convEntry, bool) {
+	if scope == "" || fingerprint == "" {
 		return nil, false
 	}
-	key := convCacheKey(accountKey, fingerprint)
+	key := convCacheKey(scope, fingerprint)
 	entry, ok, wait := c.lookupOnce(key)
 	if ok {
 		return entry, ok
@@ -135,17 +153,33 @@ func (c *conversationCache) Lookup(accountKey, fingerprint string) (*convEntry,
 // LookupNoWait returns a stored entry without blocking on an in-flight store.
 // Fallback boundary probes use it: they hash several candidate prefixes, and
 // only the exact turn-end transcript could ever be pending.
-func (c *conversationCache) LookupNoWait(accountKey, fingerprint string) (*convEntry, bool) {
-	if accountKey == "" || fingerprint == "" {
+func (c *conversationCache) LookupNoWait(scope, fingerprint string) (*convEntry, bool) {
+	if scope == "" || fingerprint == "" {
 		return nil, false
 	}
-	key := convCacheKey(accountKey, fingerprint)
+	key := convCacheKey(scope, fingerprint)
 	if entry, ok, _ := c.lookupOnce(key); ok {
 		return entry, ok
 	}
 	return c.loadPersisted(key)
 }
 
+// PendingWait returns the channel that closes when an announced store for this
+// key lands, or nil when nothing is in flight. It lets a caller probing many
+// candidate keys find the one worth waiting for without blocking on each.
+func (c *conversationCache) PendingWait(scope, fingerprint string) chan struct{} {
+	if scope == "" || fingerprint == "" {
+		return nil
+	}
+	key := convCacheKey(scope, fingerprint)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if marker := c.pending[key]; marker != nil {
+		return marker.ch
+	}
+	return nil
+}
+
 // lookupOnce returns the live entry for key, or the pending-store channel a
 // caller may wait on when the entry is not there yet.
 func (c *conversationCache) lookupOnce(key string) (*convEntry, bool, chan struct{}) {
