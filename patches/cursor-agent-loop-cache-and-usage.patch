 	cursorauth "github.com/router-for-me/CLIProxyAPI/v7/internal/auth/cursor"
@@ -243,26 +244,68 @@ func foldTurnTailText(tail []ChatMessage) string {
 // instruction to send. Resuming it anyway would replay the finished turn and
 // the model would answer that stale context instead of the request in hand. A
 // shorter boundary can still carry a real tail, so the probe keeps walking.
-func lookupPrefixResume(accountKey, wireModelID string, messages []ChatMessage) (*convEntry, string, string, bool) {
+// The matched prefix is returned alongside the checkpoint: it is the part of
+// the transcript upstream has already been sent and will serve from its own
+// cache, which is what lets the ledger bill this turn as a read rather than as
+// a fresh write of the whole prompt.
+func lookupPrefixResume(accountKey, wireModelID string, messages []ChatMessage) (*convEntry, string, string, []ChatMessage, bool) {
+	scope := convScope(accountKey, wireModelID)
 	echo := echoTranscript(messages)
 	prefixes := conversationPrefixFingerprints(echo)
-	for i := len(echo); i >= 1; i-- {
-		entry, ok := defaultConversationCache.LookupNoWait(accountKey, prefixes[i])
-		if !ok {
-			continue
-		}
+
+	// resolved reports what a boundary yields once its entry is in hand.
+	// stop is true when no shorter boundary can help either.
+	resolved := func(i int, entry *convEntry) (*convEntry, string, string, []ChatMessage, bool, bool) {
 		if entry.model != wireModelID {
-			// The conversation is pinned to another model upstream; an older
-			// boundary would be, too.
-			return nil, "", "", false
+			// Unreachable while the cache is scoped by model; kept because
+			// resuming a conversation pinned to another model upstream would
+			// answer from the wrong one.
+			log.Warnf("cursor: checkpoint for %s found under %s's scope, ignoring", entry.model, wireModelID)
+			return nil, "", "", nil, false, false
 		}
 		text := foldTurnTailText(echo[i:])
 		if strings.TrimSpace(text) == "" {
+			log.Debugf("cursor resume probe: boundary %d/%d folds to an empty tail, skipping", i, len(echo))
+			return nil, "", "", nil, false, false
+		}
+		return entry, prefixes[i], text, echo[:i], true, true
+	}
+
+	// The checkpoint for the turn this request continues is written a moment
+	// after the reply reaches the client, and an agent's next step arrives
+	// inside that window. Note the longest boundary whose store is in flight
+	// so it can be waited for rather than missed.
+	waitIdx, waitCh := 0, (chan struct{})(nil)
+	for i := len(echo); i >= 1; i-- {
+		entry, ok := defaultConversationCache.LookupNoWait(scope, prefixes[i])
+		if !ok {
+			if waitCh == nil {
+				if ch := defaultConversationCache.PendingWait(scope, prefixes[i]); ch != nil {
+					waitIdx, waitCh = i, ch
+				}
+			}
 			continue
 		}
-		return entry, prefixes[i], text, true
+		if e, fp, text, prefix, ok, stop := resolved(i, entry); stop {
+			return e, fp, text, prefix, ok
+		}
+	}
+
+	if waitCh == nil {
+		log.Debugf("cursor resume probe: %d boundaries, none stored or pending (scope=%q longest fp=%.8s)", len(echo), scope, prefixes[len(echo)])
+		return nil, "", "", nil, false
+	}
+	select {
+	case <-waitCh:
+	case <-time.After(convPendingWait):
+	}
+	entry, ok := defaultConversationCache.LookupNoWait(scope, prefixes[waitIdx])
+	if !ok {
+		log.Debugf("cursor resume probe: boundary %d/%d still absent after waiting for its store", waitIdx, len(echo))
+		return nil, "", "", nil, false
 	}
-	return nil, "", "", false
+	e, fp, text, prefix, hit, _ := resolved(waitIdx, entry)
+	return e, fp, text, prefix, hit
 }
 
