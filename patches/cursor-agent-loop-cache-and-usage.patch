+package cursor
+
+import (
+	"testing"
+	"time"
+
+	agentv1 "github.com/router-for-me/CLIProxyAPI/v7/internal/cursor/proto/agent/v1"
+)
+
+func newTestEntry(model string) *convEntry {
+	return &convEntry{
+		conversationID: "conv-" + model,
+		state:          &agentv1.ConversationStateStructure{},
+		model:          model,
+	}
+}
+
+// The store lands a moment after the reply reaches the client, and an agent's
+// next step arrives inside that window. The boundary probe used never to wait,
+// so the step missed a checkpoint that was already announced, replayed the
+// whole conversation under a fresh upstream id, and wrote its entire prompt to
+// cache instead of reading it.
+func TestBoundaryProbeWaitsForAnAnnouncedStore(t *testing.T) {
+	const account = "acct-race"
+	const model = "claude-opus-5"
+
+	opening := []ChatMessage{{Role: "user", Content: "Investigate the repo."}}
+	requestKey := conversationFingerprint(opening)
+	t.Cleanup(func() { defaultConversationCache.Invalidate(convScope(account, model), requestKey) })
+
+	scope := convScope(account, model)
+	resolve := beginPendingAll(scope, []string{requestKey})
+
+	// The client rewrote the assistant turn, so only the request-prefix
+	// boundary can match.
+	continuation := []ChatMessage{
+		opening[0],
+		{Role: "assistant", Content: "Step 1."},
+		{Role: "tool", Content: "file_1.txt"},
+	}
+
+	go func() {
+		time.Sleep(30 * time.Millisecond)
+		defaultConversationCache.Store(scope, requestKey, newTestEntry(model))
+		resolve()
+	}()
+
+	entry, gotFp, folded, prefix, ok := lookupPrefixResume(account, model, continuation)
+	if !ok {
+		t.Fatal("the probe gave up on a checkpoint whose store had been announced")
+	}
+	if gotFp != requestKey {
+		t.Fatalf("fingerprint = %.8s, want the request-prefix key %.8s", gotFp, requestKey)
+	}
+	if entry.conversationID != "conv-"+model {
+		t.Fatalf("resumed the wrong conversation: %s", entry.conversationID)
+	}
+	if folded == "" {
+		t.Fatal("the un-checkpointed tail folded to nothing")
+	}
+	if len(prefix) != 1 {
+		t.Fatalf("matched prefix has %d messages, want the 1 the checkpoint covers", len(prefix))
+	}
+}
+
+// Agent clients open every conversation with the same system prompt and the
+// same first user message, so two models routinely produce the same
+// fingerprint. Keyed by account alone they overwrote each other's checkpoints
+// and each then found one pinned to the other, so both replayed their whole
+// history uncached for the rest of the conversation.
+func TestTwoModelsDoNotEvictEachOthersCheckpoint(t *testing.T) {
+	const account = "acct-shared-opening"
+	opening := []ChatMessage{{Role: "user", Content: "Investigate the repo."}}
+	fp := conversationFingerprint(opening)
+
+	for _, model := range []string{"claude-opus-5", "grok-4.6"} {
+		scope := convScope(account, model)
+		defaultConversationCache.Store(scope, fp, newTestEntry(model))
+		t.Cleanup(func() { defaultConversationCache.Invalidate(scope, fp) })
+	}
+
+	continuation := append(append([]ChatMessage(nil), opening...),
+		ChatMessage{Role: "assistant", Content: "Step 1."},
+		ChatMessage{Role: "tool", Content: "file_1.txt"},
+	)
+
+	for _, model := range []string{"claude-opus-5", "grok-4.6"} {
+		entry, _, _, _, ok := lookupPrefixResume(account, model, continuation)
+		if !ok {
+			t.Fatalf("%s lost its checkpoint to the other model", model)
+		}
+		if entry.conversationID != "conv-"+model {
+			t.Fatalf("%s resumed %s, which belongs to another model", model, entry.conversationID)
+		}
+	}
+}
+
+// Waiting must not be unconditional: with nothing in flight the probe returns
+// promptly rather than parking for the pending timeout.
+func TestBoundaryProbeDoesNotWaitWhenNothingIsInFlight(t *testing.T) {
+	messages := []ChatMessage{
+		{Role: "user", Content: "nothing was ever stored for this"},
+		{Role: "assistant", Content: "reply"},
+		{Role: "tool", Content: "result"},
+	}
+
+	start := time.Now()
+	if _, _, _, _, ok := lookupPrefixResume("acct-empty", "claude-opus-5", messages); ok {
+		t.Fatal("resumed a conversation that was never stored")
+	}
+	if elapsed := time.Since(start); elapsed > convPendingWait/2 {
+		t.Fatalf("probe took %s with no store in flight; it should not have waited", elapsed)
+	}
+}
+
+// The announce has to cover every key the store writes, or a client that
+// rewrites the assistant turn waits on a key nobody announced.
+func TestEveryStoredCheckpointKeyIsAlsoAnnounced(t *testing.T) {
+	keys := checkpointKeys("transcript-fp", "request-fp")
+	if len(keys) != 2 || keys[0] != "transcript-fp" || keys[1] != "request-fp" {
+		t.Fatalf("keys = %v, want both the transcript and the request prefix", keys)
+	}
+	if got := checkpointKeys("same", "same"); len(got) != 1 {
+		t.Fatalf("keys = %v, want the duplicate collapsed", got)
+	}
+	if got := checkpointKeys("transcript-fp", ""); len(got) != 1 {
+		t.Fatalf("keys = %v, want no empty key", got)
+	}
+}
