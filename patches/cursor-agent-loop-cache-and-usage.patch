From 8efec9d31420646941fe3c388b634b0fad17204e Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sat, 22 Aug 2026 13:57:48 +0000
Subject: [PATCH 3/3] cursor: resize the prompt on a non-streaming continuation
 too
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Both entry points hand tool results to the live session that asked for
them, and each carried its own copy of the steps. The non-streaming copy
was missing the one that resizes the session's prompt to the request's
history, so every continuation was billed with the prompt its run opened
with — a prompt wholly inside the prefix already sent, which made the
segment report its entire prompt as a cache read, input_tokens 0, and
none of the growth the tool results added. Four steps of a loop whose
prompt grew past 16,600 tokens all reported the same 16,498.

Move the shared steps into one function both call, so the two cannot
drift apart again.
---
 internal/cursor/session.go                   | 28 +++++++++++++++++---
 internal/runtime/executor/cursor_executor.go |  8 +-----
 2 files changed, 25 insertions(+), 11 deletions(-)

diff --git a/internal/cursor/session.go b/internal/cursor/session.go
index 3e083879..c5680d2d 100644
--- a/internal/cursor/session.go
+++ b/internal/cursor/session.go
@@ -1913,13 +1913,33 @@ func buildMcpToolDefinitions(tools []ToolDefinition, renameOnWire bool) []*agent
 }
 
 // RunChat performs a text/tool Cursor Agent segment and returns the collected result.
+// ResumeWithToolResults hands tool results to the live session that asked for
+// them, after resizing that session's prompt to this request's history.
+//
+// Both entry points go through it. They used to carry their own copy of these
+// steps and the non-streaming copy was missing the resize, so every
+// non-streaming continuation was billed with the prompt its run opened with —
+// a prompt wholly inside the prefix already sent, which made the segment
+// report its entire prompt as a cache read, input_tokens 0, and none of the
+// growth the tool results added.
+func ResumeWithToolResults(messages []ChatMessage, tools []ToolDefinition, results []ToolResult) (*Session, error) {
+	session, err := DefaultSessionManager().ResolveForToolResults(results)
+	if err != nil {
+		return nil, err
+	}
+	// The resumed segment's prompt is this request's history, grown by the
+	// tool results the previous segment asked for.
+	session.SetPromptTokens(EstimatePromptTokens(messages, tools))
+	if err = session.SubmitToolResults(results); err != nil {
+		return nil, err
+	}
+	return session, nil
+}
+
 func RunChat(ctx context.Context, creds AccountCredentials, model string, messages []ChatMessage, tools []ToolDefinition, opts ...SessionOption) (*ChatResult, error) {
 	results := extractToolResults(messages)
 	if len(results) > 0 {
-		session, err := DefaultSessionManager().ResolveForToolResults(results)
-		if err == nil {
-			err = session.SubmitToolResults(results)
-		}
+		session, err := ResumeWithToolResults(messages, tools, results)
 		switch {
 		case err == nil:
 			return session.CollectSegment(ctx)
