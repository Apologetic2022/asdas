+	key := convCacheKey(scope, fingerprint)
 	c.mu.Lock()
 	if len(c.entries) >= convCacheMaxSize {
 		c.pruneLocked()
@@ -213,11 +247,11 @@ func (c *conversationCache) Store(accountKey, fingerprint string, entry *convEnt
 	persistConvEntry(key, entry)
