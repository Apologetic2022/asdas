+
+// endSegment closes a segment, billing it from an estimate when Cursor
+// reported nothing for it. A run that pauses for client tools keeps its usage
+// until the closing TurnEnded, so without this every tool-loop request would
+// answer with no usage at all and be charged as an uncached full prompt.
+func (s *Session) endSegment(reason string) {
+	s.mu.Lock()
+	var segment TokenUsage
+	if s.segmentBilled.Empty() {
+		segment = s.usage.estimate(s.promptTokens, estimateTokensFromChars(s.outputChars))
+		s.segmentBilled.add(segment)
+	}
+	s.mu.Unlock()
+	if !segment.Empty() {
+		s.emit(usageEvent(segment))
+	}
+	s.emit(StreamEvent{Type: "segment_end", Reason: reason})
+}
+
+// resetSegmentUsage starts a fresh segment's accounting; the run ledger keeps
+// what earlier segments were already billed.
