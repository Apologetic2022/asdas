+
+// resetSegmentUsage starts a fresh segment's accounting; the run ledger keeps
+// what earlier segments were already billed.
+func (s *Session) resetSegmentUsage() {
+	s.mu.Lock()
+	s.segmentBilled = TokenUsage{}
+	s.outputChars = 0
+	s.mu.Unlock()
