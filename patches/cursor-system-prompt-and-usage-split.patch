From 30893555081e24d96c807ca7789c927c60f4f0f7 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sat, 22 Aug 2026 10:14:42 +0000
Subject: [PATCH 1/4] cursor: report the four token classes as disjoint parts

The statistics store counts input, output, cache read and cache creation
as disjoint and totals them by addition, the way every other executor
reports. Cursor's input_tokens is the whole prompt with the cache
counters as subsets of it, so forwarding it as InputTokens counted the
cached tokens twice: once at the full input rate and again as cache.
Subtract the cached part so the usage panel's four columns add up.
---
 internal/runtime/executor/cursor_executor.go  | 16 ++++++---
 .../runtime/executor/cursor_usage_test.go     | 36 +++++++++++++++++--
 2 files changed, 46 insertions(+), 6 deletions(-)

diff --git a/internal/runtime/executor/cursor_executor.go b/internal/runtime/executor/cursor_executor.go
index 9cd03dc0..841894ef 100644
--- a/internal/runtime/executor/cursor_executor.go
+++ b/internal/runtime/executor/cursor_executor.go
@@ -1499,13 +1499,21 @@ func streamTokens(ev cursorlib.StreamEvent) cursorlib.TokenUsage {
 	}
 }
 
-// usageDetail renders a segment for the statistics store. Cursor's input
-// tokens already cover the whole prompt, so the cache counters are recorded
-// alongside it rather than added to it.
+// usageDetail renders a segment for the statistics store, which counts the
+// four token classes as disjoint and totals them by addition
+// (TotalTokens = input + output + cache read + cache creation, the same shape
+// every other executor reports). Cursor's input_tokens is the whole prompt with
+// the cache counters as subsets of it, so the cached part has to come back out
+// of the input figure. Reporting the whole prompt as InputTokens counts the
+// cached tokens twice: once at the full input rate and again as cache.
 func usageDetail(tokens cursorlib.TokenUsage) usage.Detail {
 	prompt := tokens.PromptTokens()
+	fresh := prompt - tokens.CacheReadTokens - tokens.CacheWriteTokens
+	if fresh < 0 {
+		fresh = 0
+	}
 	return usage.Detail{
-		InputTokens:         prompt,
+		InputTokens:         fresh,
 		OutputTokens:        tokens.OutputTokens,
 		CachedTokens:        tokens.CacheReadTokens,
 		CacheReadTokens:     tokens.CacheReadTokens,
diff --git a/internal/runtime/executor/cursor_usage_test.go b/internal/runtime/executor/cursor_usage_test.go
index 3a19fd0e..24b7ea20 100644
--- a/internal/runtime/executor/cursor_usage_test.go
+++ b/internal/runtime/executor/cursor_usage_test.go
@@ -34,14 +34,46 @@ func TestOpenAIUsagePayloadTreatsCachedTokensAsPartOfThePrompt(t *testing.T) {
 		t.Fatal("cached tokens must be a subset of the prompt")
 	}
 
+}
+
+// The statistics store counts the four token classes as disjoint and adds them
+// up, so the cached part has to come out of the input figure. Leaving the whole
+// prompt in InputTokens bills those 130000 tokens twice, once at the full input
+// rate and again as cache.
+func TestUsageDetailSplitsTheCachedPartOutOfInput(t *testing.T) {
+	tokens := cursorlib.TokenUsage{
+		InputTokens:      132250,
+		OutputTokens:     48,
+		CacheReadTokens:  130000,
+		CacheWriteTokens: 250,
+		ReasoningTokens:  16,
+	}
+
 	detail := usageDetail(tokens)
-	if detail.InputTokens != 132250 {
-		t.Fatalf("detail input = %d, want the whole prompt", detail.InputTokens)
+	if detail.InputTokens != 2000 {
+		t.Fatalf("detail input = %d, want 2000 fresh tokens", detail.InputTokens)
 	}
 	if detail.CacheReadTokens != 130000 || detail.CacheCreationTokens != 250 {
 		t.Fatalf("detail cache split = %d/%d, want 130000/250", detail.CacheReadTokens, detail.CacheCreationTokens)
 	}
+	// This is how every other executor totals a request, so the four classes
+	// must add back up to the prompt plus the completion.
+	if sum := detail.InputTokens + detail.OutputTokens + detail.CacheReadTokens + detail.CacheCreationTokens; sum != detail.TotalTokens {
+		t.Fatalf("the four classes sum to %d but total is %d", sum, detail.TotalTokens)
+	}
 	if detail.TotalTokens != 132298 {
 		t.Fatalf("detail total = %d, want 132298", detail.TotalTokens)
 	}
 }
+
+// A segment billed purely from an estimate has no cache write, and must not
+// end up with a negative fresh-input figure.
+func TestUsageDetailNeverReportsNegativeInput(t *testing.T) {
+	detail := usageDetail(cursorlib.TokenUsage{
+		InputTokens:     100,
+		CacheReadTokens: 400,
+	})
+	if detail.InputTokens != 0 {
+		t.Fatalf("detail input = %d, want 0", detail.InputTokens)
+	}
+}
-- 
