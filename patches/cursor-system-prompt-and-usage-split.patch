-	result := frames[0].GetExecClientMessage().GetReadResult()
-	if result.GetFileNotFound() == nil {
-		t.Fatalf("expected file_not_found, got %#v", result.GetResult())
+	throw := frames[0].GetExecClientControlMessage().GetThrow()
+	if throw == nil {
+		t.Fatalf("expected an unavailable throw, got %#v", frames[0].GetMessage())
 	}
-	if result.GetSuccess() != nil {
+	if !strings.Contains(throw.GetError(), "not available") {
+		t.Fatalf("throw must say the tool is unavailable, got %q", throw.GetError())
+	}
+	if frames[0].GetExecClientMessage().GetReadResult().GetSuccess() != nil {
 		t.Fatal("unknown path must not return content")
 	}
 }
@@ -301,8 +307,8 @@ func TestHandleReadArgsDoesNotServeUnrelatedReference(t *testing.T) {
 
 	frames := runReadArgs(t, s, &agentv1.ReadArgs{Path: "/etc/shadow"})
 
-	if frames[0].GetExecClientMessage().GetReadResult().GetFileNotFound() == nil {
-		t.Fatal("expected file_not_found for a path outside the reference set")
+	if frames[0].GetExecClientControlMessage().GetThrow() == nil {
+		t.Fatal("a path outside the reference set must be refused, not answered")
