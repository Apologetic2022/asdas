From f62c023cabd5b5809283e73d0ce186744b043661 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sat, 22 Aug 2026 10:14:42 +0000
Subject: [PATCH 2/4] cursor: deliver client system instructions where the
 harness reads them

A system message from the client was emitted as a system row in the
prompt blobs. The harness discards those rows: an 11k-token system block
neither reached the model nor showed up in the prompt accounting, so a
caller that puts its instructions in a system message lost them outright
and was billed as if it had never sent them. It also left the largest
cacheable block out of the conversation entirely, which is why so little
cache activity was visible.

Carry that content as a user turn, in history order so it stays inside
the cacheable prefix, and repeat the built-in tool constraint on the user
action, which is always read.
---
 internal/cursor/agent.go             | 54 +++++++++++++++++++-----
 internal/cursor/agent_system_test.go | 62 ++++++++++++++++++++++++++++
 2 files changed, 106 insertions(+), 10 deletions(-)
 create mode 100644 internal/cursor/agent_system_test.go

diff --git a/internal/cursor/agent.go b/internal/cursor/agent.go
index d210b208..990649fa 100644
--- a/internal/cursor/agent.go
+++ b/internal/cursor/agent.go
@@ -374,6 +374,27 @@ func foldToolCallText(tc *ToolCall) string {
 	return fmt.Sprintf("[called tool %s id=%s arguments=%s]", strings.TrimSpace(tc.Name), NormalizeToolCallID(tc.ID), args)
 }
 
+// builtinToolConstraint is the steering the model needs on every run: the
+// harness advertises its workspace built-ins even when no tools are attached,
+// and this gateway backs none of them.
+func builtinToolConstraint(mcpPrefixed bool) string {
+	note := "The built-in workspace tools (Shell, Read, Grep, Glob, Edit, Write, ...) are unavailable here; do not call them, wait on them, or describe their results."
+	if mcpPrefixed {
+		// Client tools are registered under mcp_-prefixed names on claude
+		// (see claudeWireModel), so the built-in of the same base name is the
+		// wrong one to reach for.
+		note += " Only the mcp_-prefixed tools attached to this conversation actually work."
+	}
+	return note
+}
+
+// systemInstructionText labels a client system message that has to travel as a
+// user turn, so the model reads it as instruction rather than as something the
+// user said.
+func systemInstructionText(content string) string {
+	return "[System instructions — follow these for the rest of the conversation]\n" + content
+}
+
 func buildRunRequest(model string, messages []ChatMessage, tools []ToolDefinition, allowImages bool) (*agentv1.AgentClientMessage, map[string][]byte, string, error) {
 	selection := ResolveRequestedModel(model)
 	claudeUpstream := claudeWireModel(selection.ModelID)
@@ -391,13 +412,7 @@ func buildRunRequest(model string, messages []ChatMessage, tools []ToolDefinitio
 	// runs that attach no tools at all, and this gateway backs none of them.
 	// Gating the warning on the tool list is what let a plain chat spend a
 	// segment on Shell and Glob and then report the environment as broken.
-	systemPrompt += " Tool note: the built-in workspace tools (Shell, Read, Grep, Glob, Edit, Write, ...) are unavailable here; do not call them, wait on them, or describe their results."
-	if claudeUpstream && len(tools) > 0 {
-		// Client tools are registered under mcp_-prefixed names on claude
-		// (see claudeWireModel), so the built-in of the same base name is the
-		// wrong one to reach for.
-		systemPrompt += " Only the mcp_-prefixed tools attached to this conversation actually work."
-	}
+	systemPrompt += " " + builtinToolConstraint(claudeUpstream && len(tools) > 0)
 	systemBlob := storeBlob(blobStore, mustJSON(map[string]any{
 		"role":    "system",
 		"content": systemPrompt,
@@ -516,13 +531,32 @@ func buildRunRequest(model string, messages []ChatMessage, tools []ToolDefinitio
 			if strings.TrimSpace(msg.Content) == "" {
 				continue
 			}
+			// The harness discards system rows: content sent that way is
+			// neither counted in the prompt nor visible to the model, so a
+			// client that puts its instructions in a system message loses them
+			// outright and its request is billed as if it never sent them. A
+			// user turn is the shape that survives, and emitting it here in
+			// history order keeps it inside the cacheable prefix.
 			rootIDs = append(rootIDs, storeBlob(blobStore, mustJSON(map[string]any{
-				"role":    "system",
-				"content": msg.Content,
+				"role": "user",
+				"content": []map[string]string{
+					{"type": "text", "text": systemInstructionText(msg.Content)},
+				},
 			})))
 		}
 	}
 
+	// The same dropped-system-row problem applies to the gateway's own
+	// steering, so the constraint the model must not miss is repeated on the
+	// user action, which is always read. Only the short note is mirrored here:
+	// the action text is the volatile tail of the prompt, and padding it with
+	// the client's whole instruction block would push it out of the cacheable
+	// prefix on every turn.
+	actionText := activeUser.Content
+	if note := builtinToolConstraint(claudeUpstream && len(tools) > 0); note != "" {
+		actionText = strings.TrimRight(actionText, "\n") + "\n\n[Tool constraint: " + note + "]"
+	}
+
 	conversationID := uuid.NewString()
 	// Desktop / cursor2api do not set exclude_workspace_context by default;
 	// forcing it true is rejected for many accounts ("Workspace context
@@ -539,7 +573,7 @@ func buildRunRequest(model string, messages []ChatMessage, tools []ToolDefinitio
 			Action: &agentv1.ConversationAction_UserMessageAction{
 				UserMessageAction: &agentv1.UserMessageAction{
 					UserMessage: &agentv1.UserMessage{
-						Text:      activeUser.Content,
+						Text:      actionText,
 						MessageId: uuid.NewString(),
 					},
 				},
diff --git a/internal/cursor/agent_system_test.go b/internal/cursor/agent_system_test.go
new file mode 100644
index 00000000..c4d88586
--- /dev/null
+++ b/internal/cursor/agent_system_test.go
@@ -0,0 +1,62 @@
+package cursor
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+// A client system message must not travel as a system row. The harness
+// discards those: the content never reaches the model and is never counted in
+// the prompt, so the caller silently loses its instructions.
+func TestClientSystemMessageTravelsWhereTheModelReadsIt(t *testing.T) {
+	const instructions = "The access code is 4242. Always answer in French."
+	msg, blobs, _, err := buildRunRequest("claude-sonnet-4-5", []ChatMessage{
+		{Role: "system", Content: instructions},
+		{Role: "user", Content: "What is the access code?"},
+	}, nil, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var carried bool
+	for _, raw := range blobs {
+		var m struct {
+			Role    string          `json:"role"`
+			Content json.RawMessage `json:"content"`
+		}
+		if json.Unmarshal(raw, &m) != nil {
+			continue
+		}
+		if !strings.Contains(string(m.Content), "The access code is 4242") {
+			continue
+		}
+		carried = true
+		if m.Role == "system" {
+			t.Fatal("client instructions were emitted as a system row, which the harness drops")
+		}
+	}
+	if !carried {
+		t.Fatal("client instructions never made it into the prompt at all")
+	}
+	_ = msg
+}
+
+// The built-in tools this gateway cannot back are refused at exec time, but the
+// model only stops reaching for them if the constraint actually reaches it.
+// System rows do not, so it has to ride on the user action as well.
+func TestBuiltinConstraintRidesOnTheUserAction(t *testing.T) {
+	msg, _, _, err := buildRunRequest("claude-sonnet-4-5", []ChatMessage{
+		{Role: "user", Content: "List the files here."},
+	}, nil, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := msg.GetRunRequest().GetAction().GetUserMessageAction().GetUserMessage().GetText()
+	if !strings.Contains(text, "List the files here.") {
+		t.Fatalf("the user's own text was lost: %q", text)
+	}
+	if !strings.Contains(text, "Tool constraint") || !strings.Contains(text, "Shell") {
+		t.Fatalf("action text carries no built-in constraint: %q", text)
+	}
+}
