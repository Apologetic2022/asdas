+	got, ok := payload["claude_cache_creation_5_m_tokens"].(int64)
+	if !ok || got != 32688 {
+		t.Fatalf("claude_cache_creation_5_m_tokens = %v, want 32688", payload["claude_cache_creation_5_m_tokens"])
+	}
+	if _, exists := payload["cache_creation_input_tokens"]; exists {
