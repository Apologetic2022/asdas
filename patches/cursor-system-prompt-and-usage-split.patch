From ede7abb2a5092e29671c413644c43dd00cafe8b3 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sat, 22 Aug 2026 10:14:42 +0000
Subject: [PATCH 3/4] cursor: refuse unbacked built-in tools uniformly

Write answered success for files nothing could read back and Read
answered file-not-found, so a run would write a file, fail to read it,
and conclude the workspace had lost it. Only generated images and
attached reference images are actually backed here; everything else now
gets the same actionable refusal as Shell and Glob, naming the tools that
do work.
---
 internal/cursor/session.go            | 83 +++++++++++++++++----------
 internal/cursor/session_image_test.go | 18 ++++--
 2 files changed, 65 insertions(+), 36 deletions(-)

diff --git a/internal/cursor/session.go b/internal/cursor/session.go
index 789134ec..f5a39500 100644
--- a/internal/cursor/session.go
+++ b/internal/cursor/session.go
@@ -1482,7 +1482,7 @@ func (s *Session) handleExec(req *agentv1.ExecServerMessage) (bool, error) {
 		if unknown := req.ProtoReflect().GetUnknown(); len(unknown) > 0 {
 			log.Warnf("cursor exec: undecoded variant, unknown field bytes (first 64): %x", truncateBytes(unknown, 64))
 		}
-		return false, rejectUnsupportedExec(s.stream, req)
+		return false, s.throwBuiltinUnavailable(req)
 	case *agentv1.ExecServerMessage_WriteArgs:
 		return false, s.handleWriteArgs(req, m.WriteArgs)
 	case *agentv1.ExecServerMessage_ReadArgs:
@@ -1539,17 +1539,22 @@ func (s *Session) handleWriteArgs(req *agentv1.ExecServerMessage, args *agentv1.
 	if len(data) == 0 && args.GetFileText() != "" {
 		data = []byte(args.GetFileText())
 	}
-	if path != "" && len(data) > 0 && strings.HasPrefix(http.DetectContentType(data), "image/") {
-		s.mu.Lock()
-		if s.writtenImages == nil {
-			s.writtenImages = map[string][]byte{}
-		}
-		s.writtenImages[path] = data
-		s.mu.Unlock()
+	isImage := path != "" && len(data) > 0 && strings.HasPrefix(http.DetectContentType(data), "image/")
+	if !isImage {
+		// Only generated images are backed here: they are captured below and
+		// handed to the client. A general file write has no reader on the
+		// other side, and answering it with success is what makes the model
+		// write a file, fail to read it back, and report the environment as
+		// broken. Refuse it the same way every other built-in is refused.
+		return s.throwBuiltinUnavailable(req)
 	}
-	// Reporting success for a write that never landed is worse than failing:
-	// the model goes on to read the file back, is told it does not exist, and
-	// concludes its whole tool environment is broken.
+	s.mu.Lock()
+	if s.writtenImages == nil {
+		s.writtenImages = map[string][]byte{}
+	}
+	s.writtenImages[path] = data
+	s.mu.Unlock()
+
 	result := &agentv1.WriteResult{
 		Result: &agentv1.WriteResult_Success{
 			Success: &agentv1.WriteSuccess{
@@ -1592,23 +1597,21 @@ func (s *Session) handleReadArgs(req *agentv1.ExecServerMessage, args *agentv1.R
 	path := strings.TrimSpace(args.GetPath())
 	data, ok := s.referenceImage(path)
 	log.Debugf("cursor read exec: path=%q served=%t bytes=%d", path, ok, len(data))
-	var result *agentv1.ReadResult
 	if !ok {
-		result = &agentv1.ReadResult{
-			Result: &agentv1.ReadResult_FileNotFound{
-				FileNotFound: &agentv1.ReadFileNotFound{Path: path},
-			},
-		}
-	} else {
-		result = &agentv1.ReadResult{
-			Result: &agentv1.ReadResult_Success{
-				Success: &agentv1.ReadSuccess{
-					Path:     path,
-					FileSize: int64(len(data)),
-					Output:   &agentv1.ReadSuccess_Data{Data: data},
-				},
+		// Only the reference images attached to this request can be read.
+		// "File not found" reads as a workspace that lost the file and invites
+		// the model to look elsewhere; saying the tool is unavailable is both
+		// true and actionable.
+		return s.throwBuiltinUnavailable(req)
+	}
+	result := &agentv1.ReadResult{
+		Result: &agentv1.ReadResult_Success{
+			Success: &agentv1.ReadSuccess{
+				Path:     path,
+				FileSize: int64(len(data)),
+				Output:   &agentv1.ReadSuccess_Data{Data: data},
 			},
-		}
+		},
 	}
 	execClient := &agentv1.ExecClientMessage{
 		Id:      req.Id,
@@ -1782,14 +1785,34 @@ func (s *Session) requestContext() *agentv1.RequestContext {
 }
 
 func rejectUnsupportedExec(stream *BidiStream, req *agentv1.ExecServerMessage) error {
+	return throwExec(stream, req, builtinUnavailableMessage(nil))
+}
+
+// builtinUnavailableMessage is what the model is told when it reaches for one
+// of the harness's own workspace tools. None of them are backed here, so the
+// reply has to be actionable: naming the tools that do work is what stops the
+// model retrying the built-in for whole segments.
+func builtinUnavailableMessage(available []string) string {
+	const lead = "This built-in tool is not available in this environment. Do not retry it. "
+	if len(available) == 0 {
+		return lead + "Answer the user directly, without tools."
+	}
+	return lead + "Use ONLY these tools instead: " + strings.Join(available, ", ") + "."
+}
+
+// throwBuiltinUnavailable answers a built-in exec with the tools this session
+// can actually run.
+func (s *Session) throwBuiltinUnavailable(req *agentv1.ExecServerMessage) error {
+	return throwExec(s.stream, req, builtinUnavailableMessage(s.availableToolNames()))
+}
+
+func throwExec(stream *BidiStream, req *agentv1.ExecServerMessage, message string) error {
 	code := "exec_variant_unsupported"
 	control := &agentv1.ExecClientControlMessage{
 		Message: &agentv1.ExecClientControlMessage_Throw{
 			Throw: &agentv1.ExecClientThrow{
-				Id: req.Id,
-				// The model reads this, so say what it should do rather than
-				// naming an internal dispatch failure it cannot act on.
-				Error:     "This tool is not available in this environment. Do not retry it; use the tools attached to the conversation, or answer without it.",
+				Id:        req.Id,
+				Error:     message,
 				ErrorCode: &code,
 			},
 		},
diff --git a/internal/cursor/session_image_test.go b/internal/cursor/session_image_test.go
index 155678ca..a5a5ac74 100644
--- a/internal/cursor/session_image_test.go
+++ b/internal/cursor/session_image_test.go
@@ -278,16 +278,22 @@ func TestHandleReadArgsMatchesOnBasename(t *testing.T) {
