 }
 
+// Only the reference images attached to a request are readable. Anything else
+// gets the same answer as every other unbacked built-in: "file not found" reads
+// as a workspace that misplaced the file and sends the model looking elsewhere.
 func TestHandleReadArgsRejectsUnknownPath(t *testing.T) {
 	// A session with no reference images must not serve host files.
 	s := &Session{}
