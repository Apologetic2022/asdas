@@ -0,0 +1,84 @@
+package cursor
+
+import "testing"
+
+// The fast tier is a different serving of the model, and on grok it comes back
+// with no prompt caching at all, so it must never be picked for a caller that
+// did not ask for it. It used to cost nothing in the score, which let the
+// effort bonus select it over the plain variant.
+func TestFastVariantIsNotChosenUnlessRequested(t *testing.T) {
+	usable := []usableModel{
+		{ID: "cursor-grok-4.6-high-fast"},
+		{ID: "cursor-grok-4.6-high"},
+	}
+
+	plain := CatalogModel{ID: "grok-4.6", Parameters: []ModelParameter{{ID: "effort", Value: "high"}}}
+	if got := matchUsableWireID(plain, usable); got != "cursor-grok-4.6-high" {
+		t.Fatalf("wire id = %q, want the non-fast variant", got)
+	}
+
+	// Reversing the catalog order must not change the answer.
+	if got := matchUsableWireID(plain, []usableModel{usable[1], usable[0]}); got != "cursor-grok-4.6-high" {
+		t.Fatalf("wire id = %q with the list reversed, want the non-fast variant", got)
+	}
+}
+
+func TestFastVariantIsChosenWhenRequested(t *testing.T) {
+	usable := []usableModel{
+		{ID: "cursor-grok-4.6-high"},
+		{ID: "cursor-grok-4.6-high-fast"},
+	}
+	asked := CatalogModel{ID: "grok-4.6", Parameters: []ModelParameter{
+		{ID: "effort", Value: "high"},
+		{ID: "fast", Value: "true"},
+	}}
+	if got := matchUsableWireID(asked, usable); got != "cursor-grok-4.6-high-fast" {
+		t.Fatalf("wire id = %q, want the fast variant the caller asked for", got)
+	}
+}
+
+// If the fast tier is the only thing the account can reach, it is still better
+// than failing the request outright.
+func TestFastVariantIsStillUsedWhenItIsTheOnlyOne(t *testing.T) {
+	usable := []usableModel{{ID: "cursor-grok-4.6-high-fast"}}
+	plain := CatalogModel{ID: "grok-4.6"}
+	if got := matchUsableWireID(plain, usable); got != "cursor-grok-4.6-high-fast" {
+		t.Fatalf("wire id = %q, want the only available variant", got)
+	}
+}
+
+// Cursor ships grok with the fast tier pre-selected in the catalog default.
+// Only the fast flag may be dropped: the reasoning effort that came with the
+// same default has to survive, or the model is silently downgraded.
+func TestCatalogDefaultDropsFastButKeepsEffort(t *testing.T) {
+	params := []ModelParameter{
+		{ID: "fast", Value: "true"},
+		{ID: "effort", Value: "high"},
+		{ID: "thinking", Value: "true"},
+	}
+	got := dropFastDefault(params)
+	for _, p := range got {
+		if p.ID == "fast" {
+			t.Fatal("fast survived the catalog default")
+		}
+	}
+	if len(got) != 2 || got[0].ID != "effort" || got[0].Value != "high" || got[1].ID != "thinking" {
+		t.Fatalf("effort/thinking did not survive: %v", got)
+	}
+}
+
+// The whole point of dropping the flag is that the plain wire id then wins.
+func TestGrokDefaultLandsOnTheStandardHighVariant(t *testing.T) {
+	usable := []usableModel{
+		{ID: "cursor-grok-4.6-high-fast"},
+		{ID: "cursor-grok-4.6-high"},
+		{ID: "cursor-grok-4.6-low"},
+	}
+	entry := CatalogModel{ID: "grok-4.6", Parameters: dropFastDefault([]ModelParameter{
+		{ID: "fast", Value: "true"},
+		{ID: "effort", Value: "high"},
+	})}
+	if got := matchUsableWireID(entry, usable); got != "cursor-grok-4.6-high" {
+		t.Fatalf("wire id = %q, want cursor-grok-4.6-high", got)
+	}
+}
