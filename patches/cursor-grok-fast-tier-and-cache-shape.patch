+// dropFastDefault removes a fast=true that came from the catalog's default
+// variant. Cursor ships grok with the fast tier pre-selected, which is a
+// different serving: it answers without prompt caching, so a long prompt is
+// billed fresh on every turn. Dropping the parameter keeps the rest of the
+// default (notably the reasoning effort) and lets the plain wire id be chosen;
+// callers who do want the fast tier still get it via the -fast suffix, which
+// sets the parameter explicitly.
+func dropFastDefault(params []ModelParameter) []ModelParameter {
+	out := params[:0]
+	for _, p := range params {
+		if strings.EqualFold(strings.TrimSpace(p.ID), "fast") {
+			continue
+		}
+		out = append(out, p)
+	}
+	return out
