From 22792aebd2ea4d8c2ab5f51721fd3c4556535b50 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sat, 22 Aug 2026 11:16:54 +0000
Subject: [PATCH 2/2] cursor: learn cache reads and writes separately per
 provider

The ledger recorded one bit per model: does this provider cache. That is too
coarse. Anthropic reports both halves, while xAI reports only the cached
portion of the prompt and never a write, because the uncached remainder is
billed as ordinary input rather than at a cache-creation premium. Estimating
the write half for grok invented a premium nobody charges.

Track the two counters separately and let an estimate attribute only the halves
its provider has actually been seen reporting; anything unattributed stays
plain input, which is how it is priced.
---
 internal/cursor/usage.go      | 62 ++++++++++++++++++++++++-----------
 internal/cursor/usage_test.go | 34 ++++++++++++++-----
 2 files changed, 68 insertions(+), 28 deletions(-)

diff --git a/internal/cursor/usage.go b/internal/cursor/usage.go
index ca012492..c6e8e911 100644
--- a/internal/cursor/usage.go
+++ b/internal/cursor/usage.go
@@ -103,28 +103,30 @@ func (u *TokenUsage) clampCacheToPrompt() {
 
 // estimate bills a segment that ended before any report arrived.
 //
-// Only models the provider actually caches get a cache split. Attributing the
-// resent prefix to the cache unconditionally invented an entire cache column
-// for models that never cache: grok runs reported a 95% hit rate across a tool
-// loop while every turn_ended for them carries cache_read_tokens:0 and
-// cache_write_tokens:0. It also only ever produced reads, so a caching model
-// looked like it read a cache nothing had ever written to.
-//
-// For a model that does cache, the prefix already sent is a read and the growth
-// beyond it is what the provider writes to the cache on this turn, which is the
-// shape a real turn_ended reports.
+// The split follows whatever the model's provider has been seen reporting, one
+// counter at a time. Attributing the resent prefix to the cache unconditionally
+// invented a cache column for models that never cache, and inventing the write
+// half for a provider that only reports reads bills a cache-creation premium
+// that xAI never charges. So the prefix already sent counts as a read only for
+// a provider that reports reads, and the growth beyond it counts as a write
+// only for a provider that reports writes; anything not attributed stays plain
+// input, which is how it is priced.
 func (r *runUsage) estimate(prompt, output int64) TokenUsage {
 	segment := TokenUsage{
 		InputTokens:  prompt,
 		OutputTokens: output,
 	}
-	if providerCaches(r.model) {
+	if shape := providerCacheShape(r.model); shape.reads || shape.writes {
 		read := r.sentPrompt
 		if read > prompt {
 			read = prompt
 		}
-		segment.CacheReadTokens = read
-		segment.CacheWriteTokens = prompt - read
+		if shape.reads {
+			segment.CacheReadTokens = read
+		}
+		if shape.writes {
+			segment.CacheWriteTokens = prompt - read
+		}
 	}
 	r.record(segment, prompt)
 	return segment
@@ -144,23 +146,43 @@ func (r *runUsage) record(segment TokenUsage, prompt int64) {
 // otherwise: claiming a cache that never existed understates the cost of every
 // segment, whereas the opposite error corrects itself on the closing segment,
 // where the cumulative report reconciles what the estimates already billed.
-var cachingProviders sync.Map // model -> struct{}
+// cacheShape records what a model's provider has actually been seen reporting.
+// The two counters are learned separately because they do not travel together:
+// Anthropic reports both a read and a write, while xAI reports only the cached
+// portion of the prompt and never a write, since it has no premium
+// cache-creation charge for the rest. Estimating a write for grok would invent
+// a cost the provider never billed.
+type cacheShape struct {
+	reads  bool
+	writes bool
+}
+
+var cachingProviders sync.Map // model -> cacheShape
 
 func noteCacheBehaviour(model string, total TokenUsage) {
 	if model == "" || (total.CacheReadTokens == 0 && total.CacheWriteTokens == 0) {
 		return
 	}
-	if _, loaded := cachingProviders.LoadOrStore(model, struct{}{}); !loaded {
-		log.Debugf("cursor usage: %s reported cache activity, estimates for it may now split the prompt", model)
+	shape := providerCacheShape(model)
+	seen := shape
+	shape.reads = shape.reads || total.CacheReadTokens > 0
+	shape.writes = shape.writes || total.CacheWriteTokens > 0
+	if shape != seen {
+		cachingProviders.Store(model, shape)
+		log.Debugf("cursor usage: %s reports cache reads=%t writes=%t, estimates now follow", model, shape.reads, shape.writes)
 	}
 }
 
-func providerCaches(model string) bool {
+func providerCacheShape(model string) cacheShape {
 	if model == "" {
-		return false
+		return cacheShape{}
+	}
+	if v, ok := cachingProviders.Load(model); ok {
+		if shape, ok := v.(cacheShape); ok {
+			return shape
+		}
 	}
-	_, ok := cachingProviders.Load(model)
-	return ok
+	return cacheShape{}
 }
 
 func remaining(total, billed int64) int64 {
