From 280530205fa107c4291b2fd2aa4f227fe4b3ee52 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sat, 22 Aug 2026 11:33:01 +0000
Subject: [PATCH 2/2] cursor: credit the resent prefix without waiting to learn
 the model caches

Gating the estimated cache read on learned behaviour gave every restart
amnesia. Cache behaviour is learned from a run's closing report, so until one
arrived for that exact model, a segment that paused for tools billed its whole
prompt as fresh input: production logs show 119,303-token requests reporting
input_tokens with no cache in either direction.

That is the reported "probes cache, real work doesn't" split. A probe is a
single turn that gets a real upstream report, while an agent's turns pause for
tools and are estimated, so the amnesia only ever showed on real work.

Cursor caches the prompt prefix for every provider measured here, and the
lineage this ledger came from credited the prefix unconditionally, so the read
goes back to being the default. The write does not: it carries a creation
premium xAI never charges, so the growth beyond the prefix stays plain input
until this provider has been seen reporting a write. The closing report
reconciles the rest.

Measured on a cold process, first run: grok holds 95% from the second turn,
claude 63.5%. Both were 0% for the whole first run before.
---
 internal/cursor/usage.go      | 43 ++++++++++++++++++-----------------
 internal/cursor/usage_test.go | 35 +++++++++++++++++++++-------
 2 files changed, 49 insertions(+), 29 deletions(-)

diff --git a/internal/cursor/usage.go b/internal/cursor/usage.go
index c6e8e911..5d6b4d97 100644
--- a/internal/cursor/usage.go
+++ b/internal/cursor/usage.go
@@ -103,30 +103,31 @@ func (u *TokenUsage) clampCacheToPrompt() {
 
 // estimate bills a segment that ended before any report arrived.
 //
-// The split follows whatever the model's provider has been seen reporting, one
-// counter at a time. Attributing the resent prefix to the cache unconditionally
-// invented a cache column for models that never cache, and inventing the write
-// half for a provider that only reports reads bills a cache-creation premium
-// that xAI never charges. So the prefix already sent counts as a read only for
-// a provider that reports reads, and the growth beyond it counts as a write
-// only for a provider that reports writes; anything not attributed stays plain
-// input, which is how it is priced.
+// The prefix the run has already pushed upstream is counted as a cache read.
+// Cursor caches the prompt prefix for every provider measured here, so this is
+// the right prior, and it must not wait to be confirmed: the counters are
+// learned from a run's closing report, so gating on them left the first run
+// after every restart reporting a six-figure prompt as entirely fresh input.
+// That is the "probes cache, real work doesn't" shape — a probe is one turn and
+// gets a real report, while an agent's turns pause for tools and are estimated.
+//
+// A cache write is not assumed. It carries a creation premium that xAI never
+// charges, so the growth beyond the prefix only becomes a write once this
+// provider has been seen reporting one; until then it stays plain input, which
+// is how it is priced. The run's closing report reconciles the difference, so
+// at worst one run's writes land on its final segment.
 func (r *runUsage) estimate(prompt, output int64) TokenUsage {
+	read := r.sentPrompt
+	if read > prompt {
+		read = prompt
+	}
 	segment := TokenUsage{
-		InputTokens:  prompt,
-		OutputTokens: output,
+		InputTokens:     prompt,
+		OutputTokens:    output,
+		CacheReadTokens: read,
 	}
-	if shape := providerCacheShape(r.model); shape.reads || shape.writes {
-		read := r.sentPrompt
-		if read > prompt {
-			read = prompt
-		}
-		if shape.reads {
-			segment.CacheReadTokens = read
-		}
-		if shape.writes {
-			segment.CacheWriteTokens = prompt - read
-		}
+	if providerCacheShape(r.model).writes {
+		segment.CacheWriteTokens = prompt - read
 	}
 	r.record(segment, prompt)
 	return segment
diff --git a/internal/cursor/usage_test.go b/internal/cursor/usage_test.go
index dfa30b49..1a4adab9 100644
--- a/internal/cursor/usage_test.go
+++ b/internal/cursor/usage_test.go
@@ -70,20 +70,39 @@ func knownCachingModel(t *testing.T) string {
 	return name
 }
 
-// A provider that has never reported a cache gets none invented for it.
-// Attributing the resent prefix to a cache anyway produced a measured 95% hit
-// rate across a tool loop that never touched a cache, and understated the run.
-func TestEstimateInventsNoCacheForAProviderThatNeverReportsOne(t *testing.T) {
-	run := runUsage{model: "uncached-" + t.Name()}
+// The read must not wait to be confirmed. Cache behaviour is learned from a
+// run's closing report, so gating the read on it meant the first run after
+// every restart billed its whole prompt as fresh input — the "probes cache,
+// real work doesn't" report, since a probe is one turn and gets a real report
+// while an agent's turns pause for tools and are estimated.
+func TestEstimateCreditsTheResentPrefixWithoutWaitingToLearn(t *testing.T) {
+	run := runUsage{model: "never-reported-" + t.Name()}
 
 	run.estimate(12499, 51)
 	second := run.estimate(13147, 33)
 
-	if second.CacheReadTokens != 0 || second.CacheWriteTokens != 0 {
-		t.Fatalf("segment = %+v, want no cache attributed at all", second)
+	if second.CacheReadTokens != 12499 {
+		t.Fatalf("cache read = %d, want the 12499-token prefix already sent", second.CacheReadTokens)
 	}
 	if second.InputTokens != 13147 {
-		t.Fatalf("input = %d, want the whole prompt charged as input", second.InputTokens)
+		t.Fatalf("input = %d, want the whole prompt, the cache being a subset", second.InputTokens)
+	}
+}
+
+// A write carries a creation premium, so unlike the read it is only attributed
+// once this provider has actually been seen reporting one.
+func TestEstimateWaitsForProofBeforeBillingACacheWrite(t *testing.T) {
+	run := runUsage{model: "reads-only-" + t.Name()}
+
+	run.estimate(12499, 51)
+	if second := run.estimate(13147, 33); second.CacheWriteTokens != 0 {
+		t.Fatalf("cache write = %d, want none before the provider reports one", second.CacheWriteTokens)
+	}
+
+	learned := runUsage{model: knownCachingModel(t)}
+	learned.estimate(12499, 51)
+	if second := learned.estimate(13147, 33); second.CacheWriteTokens != 13147-12499 {
+		t.Fatalf("cache write = %d, want the growth beyond the prefix", second.CacheWriteTokens)
 	}
 }
 
