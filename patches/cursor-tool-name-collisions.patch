+// genuinely in my available toolset alongside Write" to the user.
+//
+// The match is case-insensitive because the collision is upstream's, and a
+// client that declares "write" collides just as hard as one declaring "Write".
+func needsWirePrefix(renameOnWire bool, name string) bool {
+	return renameOnWire && cursorBuiltinToolNames[strings.ToLower(strings.TrimSpace(name))]
+}
