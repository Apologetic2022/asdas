diff --git a/internal/cursor/wire_names.go b/internal/cursor/wire_names.go
new file mode 100644
index 00000000..8960e876
--- /dev/null
+++ b/internal/cursor/wire_names.go
@@ -0,0 +1,145 @@
+package cursor
+
+import "strings"
+
+// wireNameRewriter puts the gateway's tool aliases back into the client's
+// vocabulary on the way out.
+//
+// A client tool whose name collides with one of Cursor's own is registered
+// upstream under a prefixed alias (see needsWirePrefix), so the model knows it
+// as mcp_Write and reasons about it out loud under that name: "I'll use
+// mcp_Write to create the page". The client has no such tool. The alias is the
+// gateway's own invention and it means nothing to anyone downstream, so it is
+// translated back before the text leaves.
+//
+// Only this session's aliases are rewritten. A blanket search for the prefix
+// would also rewrite a genuine mention of some other mcp_ tool, which the
+// client may well have.
+type wireNameRewriter struct {
+	// aliases maps the wire name to the name the client gave the tool.
+	aliases map[string]string
+	pending string
+}
+
+// newWireNameRewriter returns nil when no tool was renamed, which is the
+// common case and lets the caller skip the work entirely.
+func newWireNameRewriter(tools []ToolDefinition, renameOnWire bool) *wireNameRewriter {
+	if !renameOnWire {
+		return nil
+	}
+	aliases := make(map[string]string)
+	for i := range tools {
+		name := strings.TrimSpace(tools[i].Name)
+		if name != "" && needsWirePrefix(renameOnWire, name) {
+			aliases[mcpToolWirePrefix+name] = name
+		}
+	}
+	if len(aliases) == 0 {
+		return nil
+	}
+	return &wireNameRewriter{aliases: aliases}
+}
+
+// rewrite translates one streamed chunk, holding back any trailing fragment
+// that could still turn into an alias once more text arrives. Deltas split
+// wherever the upstream tokenizer happened to split, so "mcp_" and "Write"
+// routinely arrive separately.
+func (r *wireNameRewriter) rewrite(chunk string) string {
+	if r == nil {
+		return chunk
+	}
+	out, pending := r.scan(r.pending+chunk, false)
+	r.pending = pending
+	return out
+}
+
+// flush releases whatever was held back. At the end of a segment there is no
+// more text coming, so a trailing alias is complete and can be translated.
+func (r *wireNameRewriter) flush() string {
+	if r == nil || r.pending == "" {
+		return ""
+	}
+	out, _ := r.scan(r.pending, true)
+	r.pending = ""
+	return out
+}
+
+func (r *wireNameRewriter) scan(s string, atEnd bool) (string, string) {
+	var b strings.Builder
+	for i := 0; i < len(s); {
+		j := strings.Index(s[i:], mcpToolWirePrefix)
+		if j < 0 {
+			// The prefix itself can straddle two deltas ("mc" then "p_Write"),
+			// in which case there is nothing here to find yet.
+			if h := partialPrefixLen(s[i:]); h > 0 && !atEnd {
+				b.WriteString(s[i : len(s)-h])
+				return b.String(), s[len(s)-h:]
+			}
+			b.WriteString(s[i:])
+			break
+		}
+		j += i
+		b.WriteString(s[i:j])
+		tail := s[j:]
+		if alias := r.matchAt(tail, atEnd); alias != "" {
+			b.WriteString(r.aliases[alias])
+			i = j + len(alias)
+			continue
+		}
+		if !atEnd && r.couldGrowInto(tail) {
+			return b.String(), tail
+		}
+		b.WriteString(mcpToolWirePrefix)
+		i = j + len(mcpToolWirePrefix)
+	}
+	return b.String(), ""
+}
+
+// matchAt returns the longest alias starting here, provided the name ends
+// there. Without the boundary check mcp_Read would also fire inside
+// mcp_ReadNotebook, which is a different tool.
+func (r *wireNameRewriter) matchAt(tail string, atEnd bool) string {
+	best := ""
+	for alias := range r.aliases {
+		if len(alias) <= len(best) || !strings.HasPrefix(tail, alias) {
+			continue
+		}
+		if rest := tail[len(alias):]; rest == "" && !atEnd {
+			// The name may continue in the next chunk; not decidable yet.
+			continue
+		} else if rest != "" && isNameChar(rest[0]) {
+			continue
+		}
+		best = alias
+	}
+	return best
+}
+
+// couldGrowInto reports whether more text could turn this tail into an alias.
+func (r *wireNameRewriter) couldGrowInto(tail string) bool {
+	for alias := range r.aliases {
+		if strings.HasPrefix(alias, tail) || (strings.HasPrefix(tail, alias) && len(tail) == len(alias)) {
+			return true
+		}
+	}
+	return false
+}
+
+// partialPrefixLen is the length of the trailing fragment that could still
+// become the alias prefix once the next delta arrives.
+func partialPrefixLen(s string) int {
+	longest := len(mcpToolWirePrefix) - 1
+	if longest > len(s) {
+		longest = len(s)
+	}
+	for n := longest; n > 0; n-- {
+		if strings.HasPrefix(mcpToolWirePrefix, s[len(s)-n:]) {
+			return n
+		}
+	}
+	return 0
+}
+
+func isNameChar(c byte) bool {
+	return c == '_' || (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
diff --git a/internal/cursor/wire_names_test.go b/internal/cursor/wire_names_test.go
new file mode 100644
index 00000000..251579f7
--- /dev/null
+++ b/internal/cursor/wire_names_test.go
@@ -0,0 +1,97 @@
+package cursor
+
+import (
+	"strings"
+	"testing"
+)
+
+func rewriterFor(names ...string) *wireNameRewriter {
+	tools := make([]ToolDefinition, 0, len(names))
+	for _, n := range names {
+		tools = append(tools, ToolDefinition{Name: n})
+	}
+	return newWireNameRewriter(tools, true)
+}
+
+// The alias only exists between this gateway and Cursor. A client asked for
+// Write, so that is the name it has to read in the reply.
+func TestAliasIsTranslatedBackToTheClientName(t *testing.T) {
+	r := rewriterFor("Write", "Read")
+	got := r.rewrite("I'll use mcp_Write to create the page, then mcp_Read it back.") + r.flush()
+	want := "I'll use Write to create the page, then Read it back."
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+// Deltas break wherever the tokenizer broke, so the alias arrives in pieces
+// far more often than not.
+func TestAnAliasSplitAcrossDeltasIsStillTranslated(t *testing.T) {
+	for _, chunks := range [][]string{
+		{"use ", "mcp_", "Write", " now"},
+		{"use mc", "p_Wri", "te now"},
+		{"use mcp_W", "rite now"},
+		{"use mcp_Write", " now"},
+	} {
+		r := rewriterFor("Write")
+		var b strings.Builder
+		for _, c := range chunks {
+			b.WriteString(r.rewrite(c))
+		}
+		b.WriteString(r.flush())
+		if got := b.String(); got != "use Write now" {
+			t.Errorf("chunks %q produced %q", chunks, got)
+		}
+	}
+}
+
+// An alias at the very end has nothing after it to prove the name ended, so it
+// is held until the segment closes rather than emitted raw.
+func TestAnAliasAtTheEndIsTranslatedOnFlush(t *testing.T) {
+	r := rewriterFor("Write")
+	got := r.rewrite("calling mcp_Write")
+	if strings.Contains(got, "mcp_") {
+		t.Fatalf("emitted the alias before it was decidable: %q", got)
+	}
+	if final := got + r.flush(); final != "calling Write" {
+		t.Fatalf("got %q", final)
+	}
+}
+
+// Only this session's aliases are rewritten: the client may have real tools of
+// its own whose names start with the same prefix, and those must survive.
+func TestUnrelatedMcpNamesAreLeftAlone(t *testing.T) {
+	r := rewriterFor("Write")
+	got := r.rewrite("mcp_linear_createIssue and mcp_WriteFile are untouched, mcp_Write is not.") + r.flush()
+	want := "mcp_linear_createIssue and mcp_WriteFile are untouched, Write is not."
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+// A tool that was never renamed has no alias, so there is nothing to rewrite
+// and the rewriter should not exist at all.
+func TestNoRewriterWhenNothingWasRenamed(t *testing.T) {
+	if r := rewriterFor("AskUserQuestion", "Bash"); r != nil {
+		t.Fatal("built a rewriter for a toolset that was never renamed")
+	}
+	if r := newWireNameRewriter([]ToolDefinition{{Name: "Write"}}, false); r != nil {
+		t.Fatal("built a rewriter for a model that does not rename")
+	}
+	if got := (*wireNameRewriter)(nil).rewrite("mcp_Write stays"); got != "mcp_Write stays" {
+		t.Fatalf("nil rewriter altered text: %q", got)
+	}
+}
+
+// Text that merely contains the prefix must pass through unchanged and whole.
+func TestTextWithoutAnAliasIsPreserved(t *testing.T) {
+	r := rewriterFor("Write")
+	var b strings.Builder
+	for _, c := range []string{"the mcp_ prefix", " is an implementation ", "detail"} {
+		b.WriteString(r.rewrite(c))
+	}
+	b.WriteString(r.flush())
+	if got, want := b.String(), "the mcp_ prefix is an implementation detail"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
