@@ -428,12 +428,17 @@ func builtinToolConstraint(tools []ToolDefinition, mcpPrefixed bool) string {
 		if name == "" {
 			continue
 		}
-		if mcpPrefixed {
+		if needsWirePrefix(mcpPrefixed, name) {
 			// Naming the built-in each one replaces is what actually stops the
 			// model reaching for it. Telling it only that "mcp_-prefixed tools
 			// work" leaves it to guess that mcp_Bash is the shell it wanted, and
 			// it guesses wrong: it calls Shell, gets refused, and burns a
 			// segment deciding whether to believe the refusal.
+			//
+			// Only the renamed ones are described this way. Saying it about
+			// every tool told the model its entire toolset was an alias of
+			// something else, which is both false and the kind of claim that
+			// reads as an injection attempt.
 			names = append(names, fmt.Sprintf("%s%s (use this whenever %s is needed)", mcpToolWirePrefix, name, name))
 			continue
 		}
