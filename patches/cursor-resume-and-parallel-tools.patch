+++ b/internal/cursor/session_paralleltools_test.go
@@ -0,0 +1,94 @@
+package cursor
+
+import (
+	"context"
+	"io"
+	"testing"
+	"time"
+
+	agentv1 "github.com/router-for-me/CLIProxyAPI/v7/internal/cursor/proto/agent/v1"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/structpb"
+)
+
+func mcpArgsEnvelope(t *testing.T, execID, callID, city string) []byte {
+	t.Helper()
+	msg := &agentv1.AgentServerMessage{
+		Message: &agentv1.AgentServerMessage_ExecServerMessage{
+			ExecServerMessage: &agentv1.ExecServerMessage{
+				Id:     1,
+				ExecId: execID,
+				Message: &agentv1.ExecServerMessage_McpArgs{
+					McpArgs: &agentv1.McpArgs{
+						Name:               "get_weather",
+						ToolName:           "get_weather",
+						ToolCallId:         callID,
+						ProviderIdentifier: MCPProviderIdentifier,
+						Args:               map[string]*structpb.Value{"city": structpb.NewStringValue(city)},
+					},
+				},
+			},
+		},
+	}
+	payload, err := proto.Marshal(msg)
+	if err != nil {
+		t.Fatalf("marshal server message: %v", err)
+	}
+	return EncodeEnvelope(payload, false)
+}
+
+// The upstream agent emits a parallel tool batch as back-to-back frames that
+// often land in separate body reads. All of them belong to the same segment;
+// pausing on the first would hand the client one call per round trip.
+func TestReadLoopDrainsParallelToolCallsIntoOneSegment(t *testing.T) {
+	bodyR, bodyW := io.Pipe()
+	_, streamW := io.Pipe()
+	tool := ToolDefinition{Name: "get_weather"}
+	s := &Session{
+		ID:        "sess-parallel",
+		events:    make(chan StreamEvent, 16),
+		pending:   map[string]*pendingExec{},
+		tools:     []ToolDefinition{tool},
+		toolIndex: map[string]*ToolDefinition{"get_weather": &tool},
+		stream:    &BidiStream{writer: streamW, body: bodyR},
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go s.readLoop(ctx)
+
+	go func() {
+		for i, city := range []string{"Paris", "Tokyo", "Lima"} {
+			if _, err := bodyW.Write(mcpArgsEnvelope(t, "exec", string(rune('a'+i)), city)); err != nil {
+				return
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+	}()
+
+	var cities []string
+	deadline := time.After(5 * time.Second)
+	for {
+		select {
+		case ev, ok := <-s.events:
+			if !ok {
+				t.Fatalf("events closed after %v", cities)
+			}
+			switch ev.Type {
+			case "tool_call":
+				cities = append(cities, ev.ToolCall.Arguments["city"].(string))
+				continue
+			case "segment_end":
+				if ev.Reason != "tool_calls" {
+					t.Fatalf("unexpected segment end %q", ev.Reason)
+				}
+				if len(cities) != 3 {
+					t.Fatalf("parallel batch split across segments: got %v, want all three", cities)
+				}
+				return
+			}
+		case <-deadline:
+			t.Fatalf("timed out with %v", cities)
+		}
+	}
+}
