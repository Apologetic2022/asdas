+func TestLookupPrefixResumeSkipsCoveredBoundaryForShorterOne(t *testing.T) {
+	t.Setenv("CPA_CURSOR_CONV_CACHE_DIR", t.TempDir())
+	// Two checkpoints: one for the finished first turn, one keyed under the
+	// whole request a previous identical send stored.
+	firstTurn := []ChatMessage{
+		{Role: "user", Content: "what is the capital of France"},
+		{Role: "assistant", Content: "Paris"},
+	}
+	repeat := append(append([]ChatMessage(nil), firstTurn...),
+		ChatMessage{Role: "user", Content: "and of Japan"})
+
+	shortFp := conversationFingerprint(echoTranscript(firstTurn))
+	fullFp := conversationFingerprint(echoTranscript(repeat))
+	state := &agentv1.ConversationStateStructure{Turns: [][]byte{[]byte("turn")}}
+	defaultConversationCache.Store("acct-skip", shortFp, &convEntry{conversationID: "conv-short", state: state, model: "claude-opus-5"})
+	defaultConversationCache.Store("acct-skip", fullFp, &convEntry{conversationID: "conv-full", state: state, model: "claude-opus-5"})
+	defer defaultConversationCache.Invalidate("acct-skip", shortFp)
+	defer defaultConversationCache.Invalidate("acct-skip", fullFp)
+
+	entry, gotFp, folded, ok := lookupPrefixResume("acct-skip", "claude-opus-5", repeat)
+	if !ok || entry == nil {
+		t.Fatal("expected the shorter boundary to resume")
+	}
+	if entry.conversationID != "conv-short" || gotFp != shortFp {
+		t.Fatalf("expected the boundary that leaves a tail, got %q", entry.conversationID)
+	}
+	if !strings.Contains(folded, "and of Japan") {
+		t.Fatalf("resume must carry the new turn, got %q", folded)
 	}
 }
 
