 	}
+	if chunk.err == io.EOF {
+		s.emit(StreamEvent{Type: "segment_end", Reason: "stop"})
+		_ = s.Close()
+		return false, true
+	}
+	if chunk.err != nil {
+		s.fail(chunk.err)
+		return false, true
+	}
+	return endForTools, false
 }
 
